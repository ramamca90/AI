# LLM_PROVIDER=scripted runs fully offline. Use anthropic with a real key for live agents.
LLM_PROVIDER=scripted
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
INCIDENT_BUDGET_USD=2.00
AGENT_MAX_ITERATIONS=8

# Local defaults: SQLite and an in-process queue. Production uses Postgres and SQS.
DATABASE_URL=sqlite+aiosqlite:///./copilot.db
QUEUE_BACKEND=local
SQS_QUEUE_URL=
AWS_REGION=us-east-1

# Required on all write endpoints as the X-API-Key header.
API_KEY=dev-only-change-me
LOG_LEVEL=INFO
