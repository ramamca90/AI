# The operator-owned secrets have no aws_secretsmanager_secret_version on purpose. Terraform
# creates the empty container and the value is set with scripts/set-secrets.sh, so it never
# reaches tfvars or state. ECS cannot start a task whose secret has no value yet, which is why
# services stay off until enable_services is true.

resource "aws_secretsmanager_secret" "anthropic_api_key" {
  name                    = "${local.name}/anthropic-api-key"
  description             = "ANTHROPIC_API_KEY. Set with scripts/set-secrets.sh."
  recovery_window_in_days = var.secret_recovery_window_days
}

resource "aws_secretsmanager_secret" "api_key" {
  name                    = "${local.name}/api-key"
  description             = "API_KEY, the X-API-Key value. Set with scripts/set-secrets.sh."
  recovery_window_in_days = var.secret_recovery_window_days
}

# Generated, not operator-set. See rds.tf. ssl=require is the asyncpg spelling of sslmode.
resource "aws_secretsmanager_secret" "database_url" {
  name                    = "${local.name}/database-url"
  description             = "DATABASE_URL, generated by Terraform."
  recovery_window_in_days = var.secret_recovery_window_days
}

resource "aws_secretsmanager_secret_version" "database_url" {
  secret_id     = aws_secretsmanager_secret.database_url.id
  secret_string = "postgresql+asyncpg://${aws_db_instance.main.username}:${random_password.db.result}@${aws_db_instance.main.address}:${aws_db_instance.main.port}/${aws_db_instance.main.db_name}?ssl=require"
}
