# Copy this file to .env and fill in ONE of the two options below.

# Option 1: Copilot Studio > Settings > Security > Web channel security > Secret 1
COPILOT_DIRECTLINE_SECRET=

# Option 2 (agents with "No authentication"): Channels > Mobile app > Token Endpoint
COPILOT_TOKEN_ENDPOINT=

# Optional: regional Direct Line host if you get 401/403 outside the US
# COPILOT_DIRECTLINE_DOMAIN=https://europe.directline.botframework.com
