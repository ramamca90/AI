# Rendered by the nginx image's envsubst step: only ${UPPER_CASE} env vars
# that are defined get substituted; nginx $variables are left untouched.

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth_per_ip:10m rate=5r/s;
limit_req_status 429;

# Re-resolve upstream names at runtime (every 10s) instead of once at
# startup: replicas/revisions get new IPs on every deploy or restart.
# NGINX_LOCAL_RESOLVERS is filled from /etc/resolv.conf by the image entrypoint.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
resolver_timeout 3s;

# Reuse the caller's correlation id, or mint one at the edge.
map $http_x_correlation_id $correlation_id {
    default $http_x_correlation_id;
    ""      $request_id;
}

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

log_format json_access escape=json
  '{"time":"$time_iso8601","service":"gateway","method":"$request_method",'
  '"path":"$uri","status":$status,"duration_s":$request_time,'
  '"upstream":"$upstream_addr","upstream_s":"$upstream_response_time",'
  '"correlation_id":"$correlation_id","client":"$remote_addr"}';

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 1m;
    access_log /dev/stdout json_access;

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"gateway"}';
    }

    # --- identity-service (stricter rate limit on credential endpoints)
    location /v1/auth/ {
        limit_req zone=auth_per_ip burst=10 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream ${IDENTITY_SERVICE_URL};
        proxy_pass $upstream;
    }
    location /v1/users/ {
        limit_req zone=api_per_ip burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream ${IDENTITY_SERVICE_URL};
        proxy_pass $upstream;
    }

    # --- orders-service
    location /v1/orders {
        limit_req zone=api_per_ip burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream ${ORDERS_SERVICE_URL};
        proxy_pass $upstream;
    }

    # --- notification-service
    location /v1/notifications {
        limit_req zone=api_per_ip burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        set $upstream ${NOTIFICATION_SERVICE_URL};
        proxy_pass $upstream;
    }

    location / {
        default_type application/problem+json;
        return 404 '{"type":"urn:orderflow:error:not_found","title":"Not Found","status":404}';
    }

    error_page 502 503 504 = @upstream_unavailable;
    location @upstream_unavailable {
        default_type application/problem+json;
        return 503 '{"type":"urn:orderflow:error:upstream_unavailable","title":"Service Unavailable","status":503,"correlation_id":"$correlation_id"}';
    }
}
