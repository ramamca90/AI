# Copy to .env to run a single service outside Docker (uv run uvicorn ...).
ENVIRONMENT=local
LOG_JSON=false
DATABASE_URL=sqlite+aiosqlite:///./local.db
EVENT_BUS_BACKEND=memory
JWT_SECRET=local-only-jwt-secret-please-change-me-0123456789
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
